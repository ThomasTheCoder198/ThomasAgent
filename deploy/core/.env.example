# Secrets and deployment-specific values. Non-secret core defaults live in
# backend-core/internal/platform/config/config.yaml.
POSTGRES_USER=thomas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=thomas
CORE_SERVICE_TOKEN=replace-with-a-random-token-of-at-least-32-characters
# A second, different random secret: the login limiter hashes emails with it.
CORE_AUTH_LOGIN_LIMITER_KEY=replace-with-another-random-token-of-at-least-32-characters
CORE_VAULT_MASTER_KEY=
CORE_AUTH_OWNER_EMAIL=
CORE_AUTH_OWNER_PASSWORD=
GRAFANA_ADMIN_PASSWORD=change-me

# Optional deployment overrides: CORE_ENV=prod, CORE_AUTH_COOKIE_SECURE=true,
# REDIS_HOST_PORT, GRAFANA_PHOENIX_URL, VL_RETENTION and PROMETHEUS_RETENTION.
