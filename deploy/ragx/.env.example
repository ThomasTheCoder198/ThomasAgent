MINIO_ROOT_USER=thomas
MINIO_ROOT_PASSWORD=change-me-minio
# Hex only, so it is safe inside RAG_DATABASE_URL: openssl rand -hex 24
RAGX_POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
# AES-256-GCM key for provider API keys (openssl rand -base64 32). Changing it makes stored keys unreadable.
RAG_VAULT_MASTER_KEY=replace-with-openssl-rand-base64-32
# Core's App-token public keys, JSON {"<kid>":"<base64 raw Ed25519>"}. Dev: `task ragx:dev-key` prints the line.
# Rotation: list both kids until core has signed with the new key for longer than 60 seconds.
RAG_CORE_PUBLIC_KEYS={}
# Phoenix secrets: >= 32 characters, with a digit and lowercase letter; must differ.
PHOENIX_SECRET=replace-with-a-32-char-secret-0001aaaaaaaa
PHOENIX_ADMIN_SECRET=replace-with-another-32-char-secret-0002bbbb
# Development uses PHOENIX_ADMIN_SECRET as the trace bearer token.
# Production should set RAG_PHOENIX_API_KEY to a Phoenix system API key.
# Read only when the initial admin account is created; change in the UI afterward.
PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD=replace-with-a-strong-initial-password
# Optional deployment overrides: PHOENIX_HOST_PORT, QDRANT_HOST_PORT,
# RAG_OTLP_ENDPOINT and RAG_TRACE_CONTENT.
